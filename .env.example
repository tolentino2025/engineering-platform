# Brevo (Sendinblue) — envio de e-mail do formulário de contato
# Obtenha sua chave em: https://app.brevo.com/settings/keys/api
BREVO_API_KEY=xkeysib-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Remetente — DEVE ser um e-mail/domínio verificado no Brevo
# (Senders & IP -> Senders). Sem verificação a API recusa o envio.
BREVO_SENDER_EMAIL=contato@jonel.eng.br
BREVO_SENDER_NAME=Site Jonel Engenharia

# Destinatário das solicitações de proposta
PROPOSAL_TO_EMAIL=jonel@jonel.eng.br
